-- TorXakis <https://torxakis.org>
-- ---------------------------------------------------------------------------------------------- --
--
-- Model of Matrix.org -- Location Data Types -- Global State
-- ---------------------------------------------------------------------------------------------- --


-- ---------------------------------------------------------------------------------------------- --
-- global state types: Users


TYPEDEF User
        -- matrix user in the system
  ::=
        User { username  :: UserName              -- KEY: name of user (Int)
             ; password  :: PassWord              -- password of user (Int)
             ; active    :: Bool                  -- active user account, not deactivated
             ; loggedIn  :: Bool                  -- user logged in; replace by isNil(accTokens)
             ; accTokens :: AccessTokens          -- multiple valid tokens (String) (loginsessions)
             }
ENDDEF


TYPEDEF Users
  ::=
        Nil
      | Cons { hd :: User
             ; tl :: Users
             }
ENDDEF


TYPEDEF UserName
        -- username for matrix user, unique for always
        -- for TXS: 0 < username < 10000
        -- username is mapped by adapter to valid Synapse username
        -- Synapse is more restrictive in usernames than Matrix spec; adapter takes care of this
  ::=
        UserName { un :: Int }
ENDDEF


TYPEDEF UserNames
  ::=
        Nil
      | Cons { hd :: UserName
             ; tl :: UserNames
             }
ENDDEF


TYPEDEF PassWord
  ::=
        PassWord { pw :: Int }
ENDDEF


TYPEDEF AccessToken
        -- AccessToken: for security, given by SUT, unique for ever
        --   (but not very unique: only last 27 chars; sometimes very short tokens)
        -- can be: non-existent, active, valid, invalid
        -- set timeout for token validity = configuration of server
        -- after timeout: token not valid anymore, and should ask for new token
        -- until lifetime --> nondeterminism
        -- login  = ask for token; one user can login multiple time, getting multiple tokens
        -- logout = invalidate token
  ::=
        AccessToken { at :: String }
ENDDEF


TYPEDEF MaybeAccessToken
 ::=
        Nothing
      | Just { act :: AccessToken }
ENDDEF


TYPEDEF AccessTokens
  ::=
        Nil
      | Cons { hd :: AccessToken
             ; tl :: AccessTokens
             }
ENDDEF


-- ---------------------------------------------------------------------------------------------- --
-- global state types: SessionObjects


TYPEDEF SessionObject
        -- session info: SessionId and Just(token) (for Deactivate) and Nothing (for Register)
        -- what is the lifetime of a session?
  ::=
        SessionObject { sid  :: SessionId         -- session identifier (String)
                      ; mact :: MaybeAccessToken  -- session token (String) for Deactivate
                      }
ENDDEF


TYPEDEF SessionObjects
  ::=
        Nil
      | Cons { hd :: SessionObject
             ; tl :: SessionObjects
             }
ENDDEF


TYPEDEF SessionId
  ::=
        SessionId { sid :: String }
ENDDEF


-- ---------------------------------------------------------------------------------------------- --
-- global state types: Rooms


TYPEDEF Room                                      -- room for communication
  ::=
        Room { id        :: RoomId                -- KEY: roomid (String), generated by SUT
             ; name      :: MaybeRoomName         -- optional roomname (String)
             ; vis       :: RoomVisibility        -- visibility: Priovate or Public
             ; users     :: UserNames             -- users in room
             ; invitees  :: UserNames             -- users invited to room
             ; involvers :: UserNames             -- users 'involved' in room
             ; events    :: Events                -- all events that ocurred in room
             }
ENDDEF


TYPEDEF Rooms
  ::=
        Nil
      | Cons { hd :: Room
             ; tl :: Rooms
             }
ENDDEF


TYPEDEF RoomId
  ::=
        RoomId { id :: String }
ENDDEF


TYPEDEF RoomName
  ::=
        RoomName { name :: String }
ENDDEF


TYPEDEF MaybeRoomName
  ::=
        Nothing
      | Just { name :: RoomName }
ENDDEF


TYPEDEF RoomVisibility
  ::=
        Public
      | Private
ENDDEF


TYPEDEF MaybeRoomVisibility
  ::=
        Nothing
      | Just { vis :: RoomVisibility }
ENDDEF


-- ---------------------------------------------------------------------------------------------- --
-- global state types: Events


TYPEDEF Event
  ::=
        JoinRoom      { joiner  :: UserName
                      }
      | LeaveRoom     { leaver  :: UserName
                      }
      | InvitedToRoom { inviter :: UserName
                      ; invitee :: UserName
                      }
      | Message       { sender  :: UserName
                      ; content :: String
                      }
      | UnknownEvent  { user    :: UserName
                      }
ENDDEF


TYPEDEF Events
  ::=
        Nil
      | Cons { hd :: Event
             ; tl :: Events
             }
ENDDEF


-- ---------------------------------------------------------------------------------------------- --
-- global state: location variables
--   Vuss : Users
--   Vses : SessionObjects
--   Vrms : Rooms


PROCDEF vuss [ Vuss :: Users # Users ]
             ( uss0 :: Users )
  ::=
        Vuss !uss0 ?uss1
    >-> vuss [Vuss] (uss1)
ENDDEF


PROCDEF vses [ Vses  :: SessionObjects # SessionObjects ]
             ( sobs0 :: SessionObjects )
  ::=
        Vses !sobs0 ?sobs1
    >-> vses [Vses] (sobs1)
ENDDEF


PROCDEF vrms [ Vrms  :: Rooms # Rooms ]
             ( roms0 :: Rooms )
  ::=
        Vrms !roms0 ?roms1
    >-> vrms [Vrms] (roms1)
ENDDEF


-- ---------------------------------------------------------------------------------------------- --
--                                                                                                --
-- ---------------------------------------------------------------------------------------------- --

