{
    "name": "torxakis",
    "displayName": "Torxakis",
    "description": "Torxakis language extension for vscode",
    "version": "0.0.3",
    "repository": "https://github.com/gijsvcuyck/vscode-torxakis",
    "engines": {
        "vscode": "^1.63.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "configuration": {
            "title": "TorXakis",
            "properties": {
                "torxakis.scanFolder": {
                    "type": "string",
                    "default": "",
                    "description": "Optional folder to limit TorXakis file discovery to. Use a workspace folder name, a relative path like 'projectA/subdir', or an absolute path inside the workspace. Leave it empty to scan all folders."
                }
            }
        },
        "languages": [{
            "id": "torxakis",
            "aliases": ["Torxakis", "torxakis"],
            "extensions": [".txs"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "torxakis",
            "scopeName": "source.txs",
            "path": "./syntaxes/torxakis.tmLanguage.json"
        }]
    }
    ,
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:torxakis"
    ]
    ,
    "scripts": {
        "test-hover": "node ./test/hover-block-starts.js"
    }
}